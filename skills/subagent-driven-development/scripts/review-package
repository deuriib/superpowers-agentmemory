#!/usr/bin/env bash
# Generate a review package: commit list, stat summary, and the net
# diff with extended context, written to stdout for agentmemory ingestion.
# The controller saves the output as an observation via memory_save.
#
# Usage: review-package BASE HEAD
# Using the recorded per-task BASE (not HEAD~1) keeps multi-commit
# tasks intact.
set -euo pipefail

if [ $# -lt 2 ] || [ $# -gt 2 ]; then
  echo "usage: review-package BASE HEAD" >&2
  exit 2
fi

base=$1
head=$2

git rev-parse --verify --quiet "$base" >/dev/null || { echo "bad BASE: $base" >&2; exit 2; }
git rev-parse --verify --quiet "$head" >/dev/null || { echo "bad HEAD: $head" >&2; exit 2; }

{
  echo "# Review package: ${base}..${head}"
  echo
  echo "## Commits"
  git log --oneline "${base}..${head}"
  echo
  echo "## Files changed"
  git diff --stat "${base}..${head}"
  echo
  echo "## Diff"
  git diff -U10 "${base}..${head}"
}

commits=$(git rev-list --count "${base}..${head}") >&2
echo "review-package: ${commits} commit(s) generated" >&2
