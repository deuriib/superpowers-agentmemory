#!/usr/bin/env bash
# DEPRECATED: This script is no longer used in the agentmemory-native workflow.
# All SDD artifacts (briefs, reports, diffs, rulings) now live in agentmemory
# as observations and signals. No workspace directory is created.
#
# Kept for backward compatibility. The controller saves review packages
# directly as observations via `memory_save` after running review-package.
set -euo pipefail

echo "WARNING: sdd-workspace is deprecated. All artifacts live in agentmemory." >&2
echo "Use memory_save to store review packages as observations." >&2
exit 0
